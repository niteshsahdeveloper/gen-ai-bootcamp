   "source": [
    "import ollama\n",
    "message = \"\"\" What can i do on a clod day? \"\"\"\n",
    "\n",
    "llm = \"llama3.2:latest\"\n",
    "\n",
    "response = ollama.chat(\n",
    "    model=llm,\n",
    "    messages=[\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\" : message\n",
    "        }\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(response[\"message\"][\"content\"])"
   ]
  }
 ],
